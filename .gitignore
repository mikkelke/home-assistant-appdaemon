# Private: contains full names of third parties (residents/service people).
# Kept out of the public repo by design — see README.
apps/people/

# Runtime state written by the apps on the box — must never be tracked or deployed
*_state.json
*feedback*.json

# Behavioral / recorded data
*.csv
*_tape.jsonl
*_log.jsonl
*_episodes.jsonl

# Room model fitted on the box by scripts/ble_locator_train.py
ble_locator_model.json

# Media: copyrighted manuals, apartment layout drawings, maps
*.pdf
*.png
*.jpg

# Legacy ad-hoc backups (git is the history now)
*.bak
*.bak_*

# Python
__pycache__/
*.pyc

# Logs
*.log

# Test tapes are fixtures, not runtime state - re-include them past the runtime-file patterns above
!apps/appliances/tests/tapes/*.json
