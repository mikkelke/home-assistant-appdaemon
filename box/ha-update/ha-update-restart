#!/usr/bin/env python3
"""Restart Home Assistant once for staged updates while the flat is empty, then verify.

An agent stages the updates (image pulled, HACS files installed, local patches re-applied)
and arms a run:

  ha-update-restart arm --touched gls,parcel_aggregator [--core 2026.11.3] [--note TEXT]

The timer runs `ha-update-restart run` every 5 minutes. It does nothing unless a run is
armed and every gate holds: local time inside WINDOW, zone.home 0 for at least EMPTY_FOR,
every resident GPS fix farther than NEAR_M from home, and no parcel out for delivery or due
within DELIVERY_SOON (a restart takes arrival auto-unlock and the intercom down for minutes).
Then it checks the configuration, backs up .storage and the compose file, stops HA with a
long grace period, recreates the container once and verifies:

  core RUNNING (and the armed version), no repair created since the restart and no
  restart_required repair left, z2m bridge online, AppDaemon reconnected and its apps
  re-initialised without errors, every config entry of the touched domains loaded, and
  no ERROR/CRITICAL line from the touched domains in home-assistant.log.

The result goes to RUNS/<stamp>.json and LAST; the arm file is consumed either way.
A run that cannot get HA answering within UP_TIMEOUT restores the rollback image and the
.storage backup when the arm file named a core version. `run --dry` evaluates the window
and runs every check against the running instance without stopping anything.

Root only. Python standard library on the host; HA calls run inside the homeassistant
container (aiohttp) with the ha-mcp container's token.
"""
import argparse
import datetime as dt
import fcntl
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
from pathlib import Path
from zoneinfo import ZoneInfo

CPH = ZoneInfo("Europe/Copenhagen")
STATE = Path("/data/ha-update")
ARMED = STATE / "armed.json"
RUNS = STATE / "runs"
LAST = STATE / "last.json"
LOCK = STATE / "lock"
COMPOSE_DIR = Path("/data")
COMPOSE = COMPOSE_DIR / "docker-compose.yaml"
HA_CONFIG = Path("/data/homeassistant")
HA_LOG = HA_CONFIG / "home-assistant.log"
AD_LOG = Path("/data/appdaemon/logs/appdaemon.log")
CONTAINER = "homeassistant"
TOKEN_CONTAINER = "ha-mcp"
WINDOW = (8, 22)
EMPTY_FOR = dt.timedelta(minutes=10)
NEAR_M = 1500
DELIVERY_SOON = dt.timedelta(minutes=60)
PARCELS = "sensor.parcel_aggregator_incoming_parcels"
# GPS trackers of the residents (not the Wi-Fi ones person.* uses); one without a fix is skipped until it reports.
GPS_TRACKERS = {"Mikkel": "device_tracker.of9p", "Kristine": "device_tracker.kristine_iphone",
                "Claudia": "device_tracker.claudias_iphone"}
UP_TIMEOUT = 600
SETTLE_TIMEOUT = 600
SETTLE_EXTRA = 180
KEEP_BACKUPS = 5
Z2M_BRIDGE = "binary_sensor.zigbee2mqtt_bridge_connection_state"
PENDING = STATE / "pending-boot.json"
APT_ENV = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
APT_OPTS = ["-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]
ZWAVE_DEAD = "{{ states.sensor | selectattr('entity_id', 'search', '_node_status$') | selectattr('state', 'eq', 'dead') | map(attribute='entity_id') | list | join(',') }}"
KUMA_DOWN = (
    "const D=require('/app/node_modules/@louislam/sqlite3');const db=new D.Database('/app/data/kuma.db');"
    "db.all(\"select m.name, h.status from monitor m join heartbeat h on h.id=(select max(id) from heartbeat "
    "where monitor_id=m.id) where m.active=1\",(e,r)=>console.log(JSON.stringify(e?{error:String(e)}:r)))")
# (host header or SNI, check) pairs Traefik must answer on the box's LAN address after a host round.
HOST_IP = "10.21.0.5"
ROUTES = [("ha.me2go.dk", "http"), ("ma.me2go.dk", "http"), ("rethink.lan", "http"),
          ("rtr02-dkcph.edge.visotia.com", "tls")]

PROBE = r'''
import asyncio, json, os, sys
import aiohttp

URL = "http://127.0.0.1:8123"
TOKEN = os.environ["HA_TOKEN"]
H = {"Authorization": "Bearer " + TOKEN}

async def main(what):
    out = {}
    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=120)) as s:
        if "check_config" in what:
            async with s.post(URL + "/api/config/core/check_config", headers=H) as r:
                out["check_config"] = await r.json()
        if "template" in what:
            async with s.post(URL + "/api/template", headers=H, json={"template": what["template"]}) as r:
                out["template"] = await r.text()
        for eid in what.get("states", []):
            async with s.get(URL + "/api/states/" + eid, headers=H) as r:
                out.setdefault("states", {})[eid] = await r.json() if r.status == 200 else None
        async with s.ws_connect(URL + "/api/websocket", max_msg_size=64 * 1024 * 1024) as ws:
            await ws.receive_json()
            await ws.send_json({"type": "auth", "access_token": TOKEN})
            if (await ws.receive_json()).get("type") != "auth_ok":
                raise SystemExit("auth failed")
            calls = {1: {"type": "get_config"}, 2: {"type": "repairs/list_issues"},
                     3: {"type": "config_entries/get"}}
            for i, c in calls.items():
                await ws.send_json({"id": i, **c})
            got = {}
            while len(got) < len(calls):
                m = await ws.receive_json()
                if m.get("type") == "result":
                    got[m["id"]] = m.get("result")
            cfg = got[1] or {}
            out["core"] = {"state": cfg.get("state"), "version": cfg.get("version")}
            out["repairs"] = [i for i in (got[2] or {}).get("issues", []) if not i.get("ignored")]
            out["entries"] = [{"domain": e["domain"], "title": e.get("title"), "state": e.get("state"),
                               "disabled_by": e.get("disabled_by")} for e in (got[3] or [])]
    print(json.dumps(out))

asyncio.run(main(json.loads(sys.argv[1])))
'''


def now():
    return dt.datetime.now(CPH)


def sh(*cmd, check=True, timeout=300):
    return subprocess.run(cmd, capture_output=True, text=True, check=check, timeout=timeout)


def token():
    return sh("docker", "exec", TOKEN_CONTAINER, "printenv", "HOMEASSISTANT_TOKEN").stdout.strip()


def probe(what):
    r = sh("docker", "exec", "-i", "-e", "HA_TOKEN=" + token(), CONTAINER, "python3", "-c", PROBE,
           json.dumps(what), timeout=180)
    return json.loads(r.stdout)


def ha_up():
    r = sh("curl", "-s", "-m", "5", "-o", "/dev/null", "-w", "%{http_code}", "http://127.0.0.1:8123/", check=False)
    return r.stdout.strip() == "200"


def parse_ts(value):
    return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))


def distance_m(lat1, lon1, lat2, lon2):
    p1, p2 = math.radians(lat1), math.radians(lat2)
    h = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2
    return 2 * 6371000 * math.asin(math.sqrt(h))


def empty_gate(zone, at):
    if zone is None:
        return False, "zone.home missing BLOCK"
    if zone["state"] != "0":
        return False, f"zone.home={zone['state']} BLOCK"
    since = parse_ts(zone["last_changed"])
    if at - since < EMPTY_FOR:
        return False, f"empty for {int((at - since).total_seconds() // 60)} min BLOCK"
    return True, f"empty since {since.astimezone(CPH):%H:%M} ok"


def gps_gate(zone, trackers):
    """Every GPS fix must be farther than NEAR_M from home by more than its accuracy. A tracker without a fix
    (no permission yet) is skipped; any fix counts whatever its age, since iOS only reports after a move."""
    attrs = (zone or {}).get("attributes", {})
    if attrs.get("latitude") is None:
        return False, "gps: zone.home has no position BLOCK"
    ok, parts = True, []
    for name, state in trackers.items():
        a = (state or {}).get("attributes", {})
        if a.get("latitude") is None or a.get("longitude") is None:
            parts.append(f"{name} no fix")
            continue
        d = distance_m(attrs["latitude"], attrs["longitude"], a["latitude"], a["longitude"])
        accuracy = float(a.get("gps_accuracy") or 0)
        if d - accuracy > NEAR_M:
            parts.append(f"{name} {d / 1000:.1f} km ok")
        else:
            ok = False
            parts.append(f"{name} {d / 1000:.1f} km (+-{accuracy:.0f} m) BLOCK")
    return ok, "gps: " + ", ".join(parts)


def delivery_gate(incoming, at):
    """Block while a parcel is out for delivery, or is due today with its window or ETA starting within
    DELIVERY_SOON (an open window or a passed ETA without a delivery counts as close)."""
    parcels = ((incoming or {}).get("attributes") or {}).get("parcels")
    if not isinstance(parcels, list):
        return False, "deliveries: incoming parcel list unreadable BLOCK"
    close = []
    for p in parcels:
        name = f"{p.get('carrier')} {p.get('barcode')}"
        if p.get("status") == "delivered":
            continue
        if p.get("status") == "out_for_delivery":
            close.append(f"{name} out for delivery")
            continue
        start = parse_ts(p["planned_from"]) if p.get("planned_from") else None
        end = parse_ts(p["planned_to"]) if p.get("planned_to") else None
        if start and start.astimezone(CPH).date() == at.date() and start - at <= DELIVERY_SOON \
                and (end is None or end >= at):
            close.append(f"{name} due {start.astimezone(CPH):%H:%M}")
    if close:
        return False, "deliveries: " + "; ".join(close) + " BLOCK"
    return True, f"deliveries: {len(parcels)} incoming, none close ok"


def gates(at):
    """(ok, verdicts) of every condition a restart needs."""
    if not WINDOW[0] <= at.hour < WINDOW[1]:
        return False, [f"time: outside {WINDOW[0]:02d}-{WINDOW[1]:02d} BLOCK"]
    st = probe({"states": ["zone.home", PARCELS, *GPS_TRACKERS.values()]})["states"]
    checks = [empty_gate(st["zone.home"], at),
              gps_gate(st["zone.home"], {n: st[e] for n, e in GPS_TRACKERS.items()}),
              delivery_gate(st[PARCELS], at)]
    return all(ok for ok, _ in checks), [f"time: {at:%H:%M} ok"] + [v for _, v in checks]


def container_image():
    return sh("docker", "inspect", "-f", "{{.Config.Image}} {{.Image}}", CONTAINER).stdout.split()


def backup(stamp):
    compose_copy = COMPOSE_DIR / f"docker-compose.yaml.bak-ha-update-{stamp}"
    shutil.copy2(COMPOSE, compose_copy)
    tarball = COMPOSE_DIR / f"storage-backup-ha-update-{stamp}.tar.gz"
    with tarfile.open(tarball, "w:gz") as t:
        t.add(HA_CONFIG / ".storage", arcname=".storage")
    for pattern in ("storage-backup-ha-update-*.tar.gz", "docker-compose.yaml.bak-ha-update-*"):
        for old in sorted(COMPOSE_DIR.glob(pattern))[:-KEEP_BACKUPS]:
            old.unlink()
    return str(compose_copy), str(tarball)


def recreate():
    sh("docker", "stop", "-t", "120", CONTAINER, timeout=200)
    sh("docker", "compose", "-f", str(COMPOSE), "up", "-d", "--no-deps", CONTAINER, timeout=300)


def wait_up(timeout):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if ha_up():
            try:
                if probe({})["core"]["state"] == "RUNNING":
                    return True
            except Exception:
                pass
        time.sleep(10)
    return False


def rollback(armed, tarball, image_ref):
    image = armed.get("rollback_image")
    if not image:
        return "no rollback_image armed"
    sh("docker", "stop", "-t", "120", CONTAINER, timeout=200)
    sh("docker", "tag", image, image_ref)
    shutil.rmtree(HA_CONFIG / ".storage")
    with tarfile.open(tarball) as t:
        t.extractall(HA_CONFIG, filter="fully_trusted")
    sh("docker", "compose", "-f", str(COMPOSE), "up", "-d", "--no-deps", CONTAINER, timeout=300)
    return "rolled back to " + image + (" and HA answers" if wait_up(UP_TIMEOUT) else ", HA still not answering")


def ad_after(started):
    """AppDaemon lines since its reconnect to HA after `started` (naive local timestamps)."""
    lines = AD_LOG.read_text(errors="replace").splitlines()
    since = started.astimezone(CPH).replace(tzinfo=None).isoformat(sep=" ")
    tail = [l for l in lines if l[:26] >= since[:26]]
    connected = next((l for l in tail if "Connected to Home Assistant" in l), None)
    restart_i = next((i for i, l in enumerate(tail) if "Processing restart for plugin namespace 'default'" in l), None)
    if restart_i is None:
        return {"connected": connected, "namespace_restart": False}
    after = tail[restart_i:]
    return {"connected": connected, "namespace_restart": True,
            "initialized": sum("Calling initialize()" in l for l in after),
            "errors": [l[:300] for l in after if re.search(r" (ERROR|CRITICAL) ", l)][:20]}


def ha_errors(domains):
    pats = [re.compile(rf"\[(custom_components|homeassistant\.components)\.{re.escape(d)}(\.|\])") for d in domains]
    pats += [re.compile(rf"\bfor {re.escape(d)}\b") for d in domains]
    out = []
    for line in HA_LOG.read_text(errors="replace").splitlines():
        if re.search(r" (ERROR|CRITICAL) \(", line) and any(p.search(line) for p in pats):
            out.append(line[:300])
    return out[:30]


def verify(armed, started, pre_repair_ids):
    touched = armed["touched"]
    p = probe({"states": [Z2M_BRIDGE]})
    failures = []
    core = p["core"]
    if core["state"] != "RUNNING":
        failures.append(f"core state {core['state']}")
    if armed.get("core") and core["version"] != armed["core"]:
        failures.append(f"core {core['version']}, expected {armed['core']}")
    new_repairs = [f"{i['domain']}/{i['issue_id']}" for i in p["repairs"]
                   if i["issue_id"] not in pre_repair_ids or i.get("translation_key") == "restart_required"]
    if new_repairs:
        failures.append("repairs: " + ", ".join(new_repairs))
    z2m = (p["states"].get(Z2M_BRIDGE) or {}).get("state")
    if z2m != "on":
        failures.append(f"z2m bridge {z2m}")
    entries = {}
    for d in touched:
        states = [e["state"] for e in p["entries"] if e["domain"] == d and not e["disabled_by"]]
        entries[d] = states
        if not states:
            failures.append(f"{d}: no config entry")
        elif any(s != "loaded" for s in states):
            failures.append(f"{d}: entries {states}")
    ad = ad_after(started)
    if not ad.get("connected"):
        failures.append("AppDaemon did not reconnect")
    elif not ad.get("namespace_restart"):
        failures.append("AppDaemon did not re-initialise its apps")
    elif ad.get("errors"):
        failures.append(f"AppDaemon errors: {len(ad['errors'])}")
    errors = ha_errors(touched)
    if errors:
        failures.append(f"HA log errors from touched domains: {len(errors)}")
    return {"ok": not failures, "failures": failures, "core": core, "repairs": len(p["repairs"]),
            "z2m": z2m, "entries": entries, "appdaemon": ad, "ha_errors": errors}


def write_result(stamp, result):
    RUNS.mkdir(parents=True, exist_ok=True)
    path = RUNS / f"{stamp}.json"
    path.write_text(json.dumps(result, indent=1, default=str) + "\n")
    LAST.write_text(path.read_text())
    return path


def ha_started():
    """Start of the running HA instance: home-assistant.log is recreated at every start."""
    first = HA_LOG.open(errors="replace").readline()
    return parse_ts(first[:29].replace(" ", "T", 1))


def settle(started):
    end = time.monotonic() + SETTLE_TIMEOUT
    while time.monotonic() < end and not ad_after(started).get("namespace_restart"):
        time.sleep(15)
    time.sleep(SETTLE_EXTRA)


def cmd_run(args):
    STATE.mkdir(parents=True, exist_ok=True)
    if not ARMED.exists() and not args.dry:
        return 0
    with LOCK.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        armed = json.loads(ARMED.read_text()) if ARMED.exists() else {"touched": [], "note": "dry run, nothing armed"}
        if args.dry and args.host:
            armed = {**armed, "mode": "host"}
        at = now()
        ok, verdicts = gates(at)
        if args.dry:
            print(f"window: {'open' if ok else 'closed'}", *verdicts, sep="\n  ")
        elif not ok:
            return 0
        stamp = at.strftime("%Y%m%dT%H%M%S")
        result = {"stamp": stamp, "dry": args.dry, "armed": armed, "gates": verdicts, "steps": []}
        try:
            restart(args, armed, result, stamp)
        except Exception as e:
            result.update(ok=False, failures=result.get("failures", []) + [f"{type(e).__name__}: {e}"[:400]])
        result["finished"] = now().isoformat(timespec="seconds")
        if args.dry:
            print(json.dumps(result, indent=1, default=str))
        else:
            print("ok" if result["ok"] else "FAILED", write_result(stamp, result))
        return 0 if result["ok"] else 1


def restart(args, armed, result, stamp):
    pre = probe({"check_config": True})
    result["pre_repairs"] = len(pre["repairs"])
    pre_ids = {i["issue_id"] for i in pre["repairs"] if i.get("translation_key") != "restart_required"}
    if pre["check_config"].get("result") != "valid":
        result.update(ok=False, failures=["config check: " + str(pre["check_config"].get("errors"))[:300]])
    elif armed.get("mode") == "host":
        host_round(args, armed, result, stamp, pre_ids)
        if args.dry:
            result.update(verify(armed, ha_started(), pre_ids))
            failures, facts = host_checks({"expected_kernel": newest_kernel(kernel_files()),
                                           "running_before": [r["Names"] for r in docker_rows() if r["State"] == "running"]},
                                          now() - dt.timedelta(minutes=30))
            result["host"] = facts
            result["failures"] = result["failures"] + failures
            result["ok"] = not result["failures"]
    elif args.dry:
        started = ha_started()
        result["steps"].append(f"would back up and recreate {CONTAINER} ({' '.join(container_image())})")
        result.update(verify(armed, started, pre_ids))
    else:
        ARMED.rename(RUNS.parent / f"armed-{stamp}.json")
        compose_copy, tarball = backup(stamp)
        result["backups"] = [compose_copy, tarball]
        image_ref, old_id = container_image()
        result["image_before"] = old_id
        started = now()
        recreate()
        if not wait_up(UP_TIMEOUT):
            result.update(ok=False, failures=[f"HA not RUNNING {UP_TIMEOUT // 60} min after recreate"],
                          rollback=rollback(armed, tarball, image_ref) if armed.get("core") else "not attempted")
        else:
            result["up_at"] = now().isoformat(timespec="seconds")
            result["image_after"] = container_image()[1]
            settle(started)
            result.update(verify(armed, started, pre_ids))


def newest_kernel(vmlinuz_names):
    """Release string of the newest /boot/vmlinuz-<release>."""
    releases = [n.split("vmlinuz-", 1)[1] for n in vmlinuz_names if "vmlinuz-" in n]
    return max(releases, key=lambda r: [int(x) if x.isdigit() else x for x in re.split(r"[.-]", r)], default=None)


def apt_pending(simulate_output):
    """Packages a full-upgrade would still install; phased (deferred) ones do not count."""
    m = re.search(r"^(\d+) upgraded, (\d+) newly installed", simulate_output, re.M)
    return int(m.group(1)) + int(m.group(2)) if m else None


def container_problems(before, rows):
    """Containers that ran before the round and are not running and healthy now."""
    now_rows = {r["Names"]: r for r in rows}
    problems = []
    for name in before:
        r = now_rows.get(name)
        if r is None:
            problems.append(f"{name} missing")
        elif r["State"] != "running":
            problems.append(f"{name} {r['State']}")
        elif r.get("HealthStatus") not in (None, "", "none", "healthy"):
            problems.append(f"{name} {r['HealthStatus']}")
    return problems


def docker_rows():
    out = sh("docker", "ps", "-a", "--format", "{{json .}}").stdout
    return [json.loads(l) for l in out.splitlines() if l.strip()]


def kernel_files():
    return [str(p) for p in Path("/boot").glob("vmlinuz-*")]


def boot_id():
    return Path("/proc/sys/kernel/random/boot_id").read_text().strip()


def route_ok(name, kind):
    if kind == "http":
        r = sh("curl", "-sk", "-m", "10", "-o", "/dev/null", "-w", "%{http_code}", "--resolve", f"{name}:443:{HOST_IP}",
               f"https://{name}/", check=False)
        return r.stdout.strip() in ("200", "302"), r.stdout.strip()
    r = sh("sh", "-c", f"echo | openssl s_client -connect {HOST_IP}:443 -servername {name} 2>/dev/null | "
           "openssl x509 -noout -subject", check=False)
    return bool(r.stdout.strip()), r.stdout.strip()[:80]


def host_checks(pending, booted_at):
    failures, facts = [], {}
    kernel = os.uname().release
    facts["kernel"] = kernel
    if kernel != pending["expected_kernel"]:
        failures.append(f"kernel {kernel}, expected {pending['expected_kernel']}")
    if Path("/var/run/reboot-required").exists():
        failures.append("reboot-required still set")
    left = apt_pending(sh("apt-get", "-s", "full-upgrade", check=False).stdout)
    facts["apt_pending"] = left
    if left != 0:
        failures.append(f"apt full-upgrade would still install {left}")
    end = time.monotonic() + 300
    while True:
        problems = container_problems(pending["running_before"], docker_rows())
        if not problems or time.monotonic() > end:
            break
        time.sleep(15)
    facts["containers"] = problems or "all running"
    failures += [f"container {p}" for p in problems]
    images = {r["Names"]: r["Image"] for r in docker_rows()}
    for svc, image in pending.get("expected_images", {}).items():
        if images.get(svc) != image:
            failures.append(f"{svc} runs {images.get(svc)}, expected {image}")
    dead = probe({"template": ZWAVE_DEAD})["template"].strip()
    facts["zwave_dead"] = dead or "none"
    if dead:
        failures.append(f"Z-Wave dead nodes: {dead}")
    kuma = json.loads(sh("docker", "exec", "uptime", "node", "-e", KUMA_DOWN).stdout or "[]")
    down = [m["name"] for m in kuma if m.get("status") != 1] if isinstance(kuma, list) else [str(kuma)]
    facts["kuma"] = f"{len(kuma) - len(down)}/{len(kuma)} up" if isinstance(kuma, list) else kuma
    if down:
        failures.append("Kuma down: " + ", ".join(down))
    for name, kind in ROUTES:
        ok, got = route_ok(name, kind)
        facts.setdefault("routes", {})[name] = got
        if not ok:
            failures.append(f"route {name}: {got or 'no answer'}")
    since = booted_at.astimezone(dt.UTC).strftime("%Y-%m-%dT%H:%M:%S")
    logs = sh("docker", "logs", "--since", since, "traefik", check=False)
    errs = [l for l in (logs.stdout + logs.stderr).splitlines() if " ERR " in l]
    facts["traefik_err"] = len(errs)
    if errs:
        failures.append(f"Traefik ERR lines: {len(errs)} ({errs[0][-160:]})")
    return failures, facts


def host_round(args, armed, result, stamp, pre_ids):
    services = armed.get("recreate", [])
    projects = armed.get("projects", [])
    simulate = sh("apt-get", "-s", "full-upgrade", check=False).stdout
    result["apt_planned"] = apt_pending(simulate)
    if args.dry:
        result["steps"] += [f"would apt full-upgrade {result['apt_planned']} packages, autoremove, "
                            f"recreate {services} and projects {projects}, then reboot",
                            f"newest kernel installed now: {newest_kernel(kernel_files())}"]
        return
    ARMED.rename(STATE / f"armed-{stamp}.json")
    compose_copy, tarball = backup(stamp)
    result["backups"] = [compose_copy, tarball]
    for proj in projects:
        for f in Path(proj).glob("docker-compose*.yml"):
            shutil.copy2(f, f.with_name(f.name + f".bak-ha-update-{stamp}"))
    log = RUNS / f"{stamp}-apt.log"
    RUNS.mkdir(parents=True, exist_ok=True)
    with log.open("w") as out:
        for cmd in (["apt-get", "update"], ["apt-get", *APT_OPTS, "full-upgrade"], ["apt-get", *APT_OPTS, "autoremove", "--purge"]):
            out.write(f"$ {' '.join(cmd)}\n")
            out.flush()
            subprocess.run(cmd, stdout=out, stderr=subprocess.STDOUT, env=APT_ENV, check=True, timeout=3600)
    result["steps"].append(f"apt done, log {log}")
    running = [r["Names"] for r in docker_rows() if r["State"] == "running"]
    if services:
        sh("docker", "compose", "-f", str(COMPOSE), "up", "-d", "--no-deps", *services, timeout=900)
    for proj in projects:
        subprocess.run(["docker", "compose", "up", "-d", "--remove-orphans"], cwd=proj, check=True,
                       capture_output=True, text=True, timeout=900)
    result["steps"].append(f"recreated {services} {projects}")
    rows = {r["Names"]: r["Image"] for r in docker_rows()}
    labels = {r["Names"]: r.get("Labels", "") for r in docker_rows()}
    expected = {}
    for name, image in rows.items():
        m = re.search(r"com\.docker\.compose\.service=([^,]+)", labels[name])
        if m and m.group(1) in services:
            expected[name] = image
    pending = {"stamp": stamp, "result": result, "pre_ids": sorted(pre_ids), "boot_id": boot_id(),
               "expected_kernel": newest_kernel(kernel_files()), "running_before": running,
               "expected_images": expected, "restart_z2m": "mqtt" in services}
    PENDING.write_text(json.dumps(pending, indent=1, default=str) + "\n")
    sh("docker", "stop", "-t", "120", CONTAINER, timeout=200)
    result["steps"].append("rebooting")
    subprocess.run(["systemctl", "reboot"], check=False)
    raise SystemExit(0)


def cmd_post_boot(_args):
    if not PENDING.exists():
        return 0
    pending = json.loads(PENDING.read_text())
    if pending["boot_id"] == boot_id():
        return 0
    PENDING.rename(STATE / f"pending-boot-{pending['stamp']}.json")
    result = pending["result"]
    booted_at = now()
    result["booted_at"] = booted_at.isoformat(timespec="seconds")
    try:
        if not wait_up(UP_TIMEOUT):
            result.update(ok=False, failures=[f"HA not RUNNING {UP_TIMEOUT // 60} min after boot"])
        else:
            if pending.get("restart_z2m"):
                time.sleep(30)
                sh("docker", "restart", "zigbee2mqtt", timeout=180)
                result["steps"].append("restarted zigbee2mqtt after the broker")
            settle(ha_started())
            result.update(verify(result["armed"], ha_started(), set(pending["pre_ids"])))
            failures, facts = host_checks(pending, booted_at)
            result["host"] = facts
            result["failures"] = result["failures"] + failures
            result["ok"] = not result["failures"]
    except Exception as e:
        result.update(ok=False, failures=result.get("failures", []) + [f"{type(e).__name__}: {e}"[:400]])
    result["finished"] = now().isoformat(timespec="seconds")
    print("ok" if result["ok"] else "FAILED", write_result(pending["stamp"], result))
    return 0 if result["ok"] else 1


def cmd_arm(args):
    STATE.mkdir(parents=True, exist_ok=True)
    armed = {"mode": "host" if args.host else "ha", "recreate": [x for x in args.recreate.split(",") if x],
             "projects": args.project or [],
             "touched": [d for d in args.touched.split(",") if d], "core": args.core,
             "rollback_image": args.rollback_image, "note": args.note, "session": args.session,
             "armed_at": now().isoformat(timespec="seconds")}
    if args.core and not args.rollback_image:
        sys.exit("--core needs --rollback-image (the tag of the image running now)")
    ARMED.write_text(json.dumps(armed, indent=1) + "\n")
    print(ARMED.read_text(), end="")


def cmd_status(_args):
    print("armed:", ARMED.read_text() if ARMED.exists() else "no")
    if PENDING.exists():
        print("pending reboot check:", json.loads(PENDING.read_text())["stamp"])
    try:
        ok, verdicts = gates(now())
        print(f"window now: {'open' if ok else 'closed'}", *verdicts, sep="\n  ")
    except Exception as e:
        print(f"window now: unknown ({type(e).__name__}: {e})")
    print("last:", LAST.read_text() if LAST.exists() else "none")


def main():
    if os.geteuid() != 0:
        sys.exit("run as root")
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("arm")
    a.add_argument("--touched", default="", help="comma-separated integration domains")
    a.add_argument("--core", help="HA version the recreate must bring up")
    a.add_argument("--rollback-image", help="local tag of the image running now, e.g. ha-rollback:2026.11.1")
    a.add_argument("--host", action="store_true", help="host round: apt full-upgrade, recreate, reboot")
    a.add_argument("--recreate", default="", help="host round: compose services in /data to recreate")
    a.add_argument("--project", action="append", help="host round: other compose project dir to bring up")
    a.add_argument("--note", default="")
    a.add_argument("--session", default="", help="how to reopen the arming conversation")
    r = sub.add_parser("run")
    r.add_argument("--dry", action="store_true", help="evaluate window and checks only, change nothing")
    r.add_argument("--host", action="store_true", help="with --dry, treat the batch as a host round")
    sub.add_parser("status")
    sub.add_parser("post-boot", help="boot oneshot: finish a host round after its reboot")
    args = ap.parse_args()
    return {"arm": cmd_arm, "run": cmd_run, "status": cmd_status, "post-boot": cmd_post_boot}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main() or 0)
