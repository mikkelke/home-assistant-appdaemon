#!/usr/bin/env python3
"""WAN outage forensics probe.

Pings six targets once a second and queries two DNS resolvers every five
seconds, so a drop can be pinned to the layer that failed:

  udm           the router, over the LAN
  gw4, gw6      the ISP gateways, one hop past the router
  cf4, g4, cf6  public internet hosts
  dns_udm       UDP DNS answers from the router
  dns_cf        UDP DNS answers from 1.1.1.1

A target is down after 3 consecutive losses and up after 3 consecutive
replies. When any target except the router goes down an incident opens: mtr
traces and route and neighbour snapshots are written to incidents/<start>/ and
repeated every 30 s until every target has been up for 10 s. The incident is
then classified by the layers that failed.

Events are appended to events.jsonl, one JSON object per line.
"""
import argparse
import asyncio
import json
import os
import re
import secrets
import shutil
import signal
import socket
import struct
import sys
import tempfile
import time
from collections import deque
from datetime import datetime, timezone

LOG_DIR = "/var/log/wan-probe"
DOWN_AFTER = 3
UP_AFTER = 3
CLOSE_AFTER = 10.0
MTR_EVERY = 30.0
MTR_RUNS = 10
MTR_CYCLES = "10"
MTR_TIMEOUT = 60.0
SNAPSHOT_TIMEOUT = 10.0
DNS_EVERY = 5.0
DNS_TIMEOUT = 2.0
SUMMARY_EVERY = 60
PING_SILENCE = 5.0

# name, host, IP family, role. Only the "lan" role never opens an incident.
PING_TARGETS = (
    ("udm", "10.21.0.1", 4, "lan"),
    ("gw4", "185.10.221.65", 4, "gateway"),
    ("gw6", "2a03:5440:2000:2a::1", 6, "gateway"),
    ("cf4", "1.1.1.1", 4, "internet"),
    ("g4", "8.8.8.8", 4, "internet"),
    ("cf6", "2606:4700:4700::1111", 6, "internet"),
)
DNS_TARGETS = (("dns_udm", "10.21.0.1"), ("dns_cf", "1.1.1.1"))
MTR_TARGETS = (
    ("cf4", "1.1.1.1", 4),
    ("g4", "8.8.8.8", 4),
    ("cf6", "2606:4700:4700::1111", 6),
)

PIPE = asyncio.subprocess.PIPE
STDOUT = asyncio.subprocess.STDOUT
DNS_QUESTION = b"\x07example\x03com\x00\x00\x01\x00\x01"

REPLY = re.compile(r"^\[(\d+\.\d+)\] \d+ bytes from \S+: icmp_seq=(\d+) .*?time=([\d.]+) ms(.*)$")
LOST = re.compile(r"^\[(\d+\.\d+)\] no answer yet for icmp_seq=(\d+)")
ERROR = re.compile(r"^\[(\d+\.\d+)\] From (\S+)(?: icmp_seq=(\d+))? (.+)$")


class Target:
    def __init__(self, name, host, family, role, kind="icmp"):
        self.name = name
        self.host = host
        self.family = family
        self.role = role
        self.kind = kind
        self.state = None
        self.oks = 0
        self.fails = 0
        self.first_ok = 0.0
        self.first_fail = 0.0
        self.down_since = None
        self.lost_seqs = deque(maxlen=32)
        self.proc = None
        self.reset_window()

    def reset_window(self):
        self.sent = 0
        self.lost = 0
        self.rtt_n = 0
        self.rtt_sum = 0.0
        self.rtt_max = 0.0


def make_targets():
    targets = [Target(*spec) for spec in PING_TARGETS]
    targets += [Target(name, host, 4, "dns", kind="dns") for name, host in DNS_TARGETS]
    return targets


def iso(ts=None):
    stamp = time.time() if ts is None else ts
    return datetime.fromtimestamp(stamp, timezone.utc).astimezone().isoformat(timespec="milliseconds")


def parse_ping(line):
    """Returns ("reply", ts, seq, rtt_ms), ("lost", ts, seq),
    ("error", ts, seq, source, message) or None for anything else."""
    m = REPLY.match(line)
    if m:
        return None if "DUP!" in m[4] else ("reply", float(m[1]), int(m[2]), float(m[3]))
    m = LOST.match(line)
    if m:
        return ("lost", float(m[1]), int(m[2]))
    m = ERROR.match(line)
    if m:
        return ("error", float(m[1]), int(m[3]) if m[3] else None, m[2], m[4])
    return None


def classify(down):
    """Names the failed layer from every target that was down during an incident."""
    icmp = [t for t in down if t.kind == "icmp"]
    if any(t.role == "lan" for t in icmp):
        return "lan"
    if not icmp:
        return "dns_only"
    families = {t.family for t in icmp}
    if families == {4}:
        return "ipv4_only"
    if families == {6}:
        return "ipv6_only"
    return "isp_gateway" if any(t.role == "gateway" for t in icmp) else "upstream"


async def dns_query(server):
    """Returns (rtt_ms, None) on a good A answer for example.com, else (None, reason)."""
    loop = asyncio.get_running_loop()
    qid = secrets.randbits(16)
    packet = struct.pack(">HHHHHH", qid, 0x0100, 1, 0, 0, 0) + DNS_QUESTION
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setblocking(False)
    start = loop.time()
    try:
        sock.connect((server, 53))
        await loop.sock_sendall(sock, packet)
        data = await asyncio.wait_for(loop.sock_recv(sock, 512), DNS_TIMEOUT)
    except asyncio.TimeoutError:
        return None, "timeout"
    except OSError as e:
        return None, e.strerror or type(e).__name__
    finally:
        sock.close()
    rtt = (loop.time() - start) * 1000
    if len(data) < 12:
        return None, "short reply"
    rid, flags, _, answers = struct.unpack(">HHHH", data[:8])
    if rid != qid or not flags & 0x8000:
        return None, "bad reply"
    if flags & 15:
        return None, f"rcode {flags & 15}"
    if not answers:
        return None, "no answer"
    return rtt, None


async def run_to_file(path, argv, timeout):
    with open(path, "wb") as f:
        f.write(f"# {iso()} {' '.join(argv)}\n".encode())
        f.flush()
        proc = await asyncio.create_subprocess_exec(*argv, stdout=f, stderr=STDOUT)
        try:
            await asyncio.wait_for(proc.wait(), timeout)
        except asyncio.TimeoutError:
            proc.kill()
            await proc.wait()
            f.write(f"# killed after {timeout:.0f} s\n".encode())
        finally:
            if proc.returncode is None:
                proc.kill()
                await proc.wait()
        f.write(f"# exit {proc.returncode}\n".encode())


class EventLog:
    def __init__(self, path):
        self.fh = open(path, "a", buffering=1)

    def write(self, ev, ts=None, **fields):
        row = {"ts": iso(ts), "ev": ev, **fields}
        try:
            self.fh.write(json.dumps(row, separators=(",", ":")) + "\n")
        except OSError as e:
            print(f"event log write failed: {e}", file=sys.stderr)

    def close(self):
        self.fh.close()


class Incident:
    def __init__(self, probe, name, path, down):
        self.probe = probe
        self.name = name
        self.path = path
        self.open = {}
        self.seen = set()
        self.total = {}
        self.begin = None
        self.end = None
        self.clear_since = None
        self.runs = 0
        self.closed = False
        for target, since in down.items():
            self.went_down(target, since)

    def went_down(self, name, since):
        self.open[name] = since
        self.seen.add(name)
        self.begin = since if self.begin is None else min(self.begin, since)
        self.clear_since = None

    def came_up(self, name, since):
        began = self.open.pop(name, None)
        if began is None:
            return
        self.total[name] = self.total.get(name, 0.0) + max(0.0, since - began)
        self.end = since if self.end is None else max(self.end, since)
        if not self.open:
            self.clear_since = time.monotonic()

    async def run(self):
        next_run = time.monotonic()
        while not self.closed:
            now = time.monotonic()
            if self.runs < MTR_RUNS and now >= next_run:
                self.runs += 1
                next_run += MTR_EVERY
                self.probe.spawn(self.capture, self.runs)
            if self.clear_since is not None and now - self.clear_since >= CLOSE_AFTER:
                self.close("recovered")
            await asyncio.sleep(0.5)

    async def capture(self, n):
        prefix = os.path.join(self.path, f"run{n:02d}-")
        self.probe.log.write("incident_run", incident=self.name, run=n)
        jobs = [
            run_to_file(prefix + "ip-route.txt", ["ip", "route"], SNAPSHOT_TIMEOUT),
            run_to_file(prefix + "ip6-route.txt", ["ip", "-6", "route"], SNAPSHOT_TIMEOUT),
            run_to_file(prefix + "ip-neigh.txt", ["ip", "neigh"], SNAPSHOT_TIMEOUT),
        ]
        # Routers rate-limit ICMP errors per destination, so concurrent mtr runs of one
        # IP family show phantom loss on the early hops. Each family runs in sequence.
        for family in (4, 6):
            jobs.append(self.mtr_chain(prefix, [spec for spec in MTR_TARGETS if spec[2] == family]))
        for result in await asyncio.gather(*jobs, return_exceptions=True):
            if isinstance(result, Exception):
                self.probe.log.write("error", where="capture", incident=self.name, run=n, error=repr(result))

    async def mtr_chain(self, prefix, chain):
        for name, host, family in chain:
            argv = ["mtr"] + (["-6"] if family == 6 else [])
            argv += ["--report", "--report-cycles", MTR_CYCLES, "-n", host]
            await run_to_file(prefix + f"mtr-{name}.txt", argv, MTR_TIMEOUT)

    def close(self, reason):
        now = time.time()
        for name, since in self.open.items():
            self.total[name] = self.total.get(name, 0.0) + max(0.0, now - since)
        end = now if self.open or self.end is None else self.end
        self.probe.log.write(
            "incident_end",
            incident=self.name,
            reason=reason,
            classification=classify([self.probe.targets[n] for n in self.seen]),
            outage_start=iso(self.begin),
            outage_end=iso(end),
            duration_s=round(end - self.begin, 1),
            down_s={n: round(s, 1) for n, s in sorted(self.total.items())},
            runs=self.runs,
        )
        self.closed = True
        self.probe.incident = None


class Probe:
    def __init__(self, log_dir, targets):
        self.log_dir = log_dir
        os.makedirs(os.path.join(log_dir, "incidents"), exist_ok=True)
        self.log = EventLog(os.path.join(log_dir, "events.jsonl"))
        self.targets = {t.name: t for t in targets}
        self.incident = None
        self.tasks = set()
        self.window_start = time.time()

    def spawn(self, fn, *args, retry=False):
        async def guarded():
            while True:
                try:
                    await fn(*args)
                    return
                except asyncio.CancelledError:
                    raise
                except Exception as e:
                    self.log.write("error", where=fn.__name__, error=repr(e))
                    if not retry:
                        return
                    await asyncio.sleep(1)

        task = asyncio.create_task(guarded())
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    def start(self):
        self.log.write("probe_start", pid=os.getpid(), targets={t.name: t.host for t in self.targets.values()})
        for t in self.targets.values():
            self.spawn(self.dns_loop if t.kind == "dns" else self.ping_loop, t, retry=True)
        self.spawn(self.summary_loop, retry=True)

    async def shutdown(self):
        if self.incident:
            self.incident.close("probe_stopped")
        tasks = list(self.tasks)
        for task in tasks:
            task.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)
        self.log.write("probe_stop")
        self.log.close()

    async def ping_loop(self, t):
        while True:
            t.lost_seqs.clear()
            why = await self.ping_session(t)
            now = time.time()
            self.record(t, now, sent=now, reason=why)
            await asyncio.sleep(1)

    async def ping_session(self, t):
        env = {**os.environ, "LC_ALL": "C"}
        proc = await asyncio.create_subprocess_exec(
            "ping", f"-{t.family}", "-D", "-O", "-n", "-i", "1", "-W", "1", t.host,
            stdout=PIPE, stderr=STDOUT, env=env,
        )
        t.proc = proc
        last = ""
        try:
            while True:
                raw = await asyncio.wait_for(proc.stdout.readline(), PING_SILENCE)
                if not raw:
                    break
                line = raw.decode(errors="replace").strip()
                last = line or last
                self.ping_line(t, line)
        except asyncio.TimeoutError:
            last = f"no output for {PING_SILENCE:.0f} s"
        finally:
            if proc.returncode is None:
                proc.kill()
            await proc.wait()
        return f"ping exited {proc.returncode}: {last}"

    def ping_line(self, t, line):
        parsed = parse_ping(line)
        if parsed is None:
            return
        kind, ts = parsed[0], parsed[1]
        if kind == "reply":
            seq, rtt = parsed[2], parsed[3]
            if seq in t.lost_seqs:
                t.lost_seqs.remove(seq)
                self.log.write("late_reply", ts, target=t.name, seq=seq, rtt_ms=rtt)
            else:
                self.record(t, ts, rtt=rtt)
        elif kind == "lost":
            t.lost_seqs.append(parsed[2])
            # ping -O reports a probe as lost while sending the next one, a second later
            self.record(t, ts, sent=ts - 1.0, seq=parsed[2])
        else:
            self.log.write("icmp_error", ts, target=t.name, seq=parsed[2], src=parsed[3], msg=parsed[4])

    async def dns_loop(self, t):
        loop = asyncio.get_running_loop()
        due = loop.time()
        while True:
            sent = time.time()
            rtt, reason = await dns_query(t.host)
            if rtt is None:
                self.record(t, time.time(), sent=sent, reason=reason)
            else:
                self.record(t, time.time(), rtt=rtt)
            due = max(due + DNS_EVERY, loop.time())
            await asyncio.sleep(due - loop.time())

    async def summary_loop(self):
        while True:
            await asyncio.sleep(SUMMARY_EVERY - time.time() % SUMMARY_EVERY + 0.05)
            now = time.time()
            stats = {}
            for t in self.targets.values():
                stats[t.name] = {
                    "sent": t.sent,
                    "lost": t.lost,
                    "avg_ms": round(t.rtt_sum / t.rtt_n, 2) if t.rtt_n else None,
                    "max_ms": round(t.rtt_max, 2) if t.rtt_n else None,
                }
                t.reset_window()
            self.log.write("summary", now, window_s=round(now - self.window_start, 1), targets=stats)
            self.window_start = now

    def record(self, t, ts, rtt=None, sent=None, **why):
        t.sent += 1
        if rtt is not None:
            t.rtt_n += 1
            t.rtt_sum += rtt
            t.rtt_max = max(t.rtt_max, rtt)
            if t.oks == 0:
                t.first_ok = ts
            t.oks += 1
            t.fails = 0
            if t.oks >= UP_AFTER and t.state != "up":
                self.transition(t, "up", ts, t.first_ok)
            return
        t.lost += 1
        t.oks = 0
        if t.fails == 0:
            t.first_fail = sent
        t.fails += 1
        self.log.write("dns_fail" if t.kind == "dns" else "loss", ts,
                       target=t.name, sent=iso(sent), streak=t.fails, **why)
        if t.fails >= DOWN_AFTER and t.state != "down":
            self.transition(t, "down", ts, t.first_fail)

    def transition(self, t, state, ts, since):
        row = {"target": t.name, "state": state, "prev": t.state, "since": iso(since)}
        if state == "up" and t.down_since is not None:
            row["down_s"] = round(max(0.0, since - t.down_since), 1)
        self.log.write("state", ts, **row)
        t.state = state
        t.down_since = since if state == "down" else None
        if state == "down":
            if self.incident:
                self.incident.went_down(t.name, since)
            elif t.role != "lan":
                self.open_incident(t, ts)
        elif self.incident:
            self.incident.came_up(t.name, since)

    def open_incident(self, trigger, ts):
        name = datetime.fromtimestamp(ts, timezone.utc).astimezone().strftime("%Y-%m-%dT%H-%M-%S%z")
        path = os.path.join(self.log_dir, "incidents", name)
        os.makedirs(path, exist_ok=True)
        down = {t.name: t.down_since for t in self.targets.values() if t.state == "down"}
        self.incident = Incident(self, name, path, down)
        self.log.write("incident_start", ts, incident=name, trigger=trigger.name,
                       down={n: iso(s) for n, s in down.items()}, dir=path)
        self.spawn(self.incident.run)


async def serve():
    probe = Probe(LOG_DIR, make_targets())
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    probe.start()
    await stop.wait()
    await probe.shutdown()


