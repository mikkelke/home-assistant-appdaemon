def read_rows(path):
    rows = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return rows


async def wait_row(path, match, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for row in read_rows(path):
            if match(row):
                return row
        await asyncio.sleep(0.5)
    return None


def state_machine_check(check):
    tmp = tempfile.mkdtemp(prefix="wan-probe-selftest-")
    try:
        probe = Probe(tmp, [Target("t", "192.0.2.1", 4, "lan")])
        t = probe.targets["t"]
        clock = 1000.0
        seq = 0

        def step(kind):
            nonlocal clock, seq
            clock += 1.0
            seq += 1
            if kind == "r":
                probe.ping_line(t, f"[{clock:.6f}] 64 bytes from 192.0.2.1: icmp_seq={seq} ttl=64 time=1.5 ms")
            else:
                probe.ping_line(t, f"[{clock:.6f}] no answer yet for icmp_seq={seq}")

        for kind in "rrrllrlllrr":
            step(kind)
        probe.ping_line(t, f"[{clock:.6f}] 64 bytes from 192.0.2.1: icmp_seq={seq} ttl=64 time=1.5 ms (DUP!)")
        probe.ping_line(t, f"[{clock:.6f}] From 10.0.0.1 icmp_seq={seq} Destination Host Unreachable")
        step("l")
        lost_seq = seq
        for kind in "rrr":
            step(kind)
        probe.ping_line(t, f"[{clock + 0.5:.6f}] 64 bytes from 192.0.2.1: icmp_seq={lost_seq} ttl=64 time=1200 ms")
        probe.log.close()
        rows = read_rows(os.path.join(tmp, "events.jsonl"))
    finally:
        shutil.rmtree(tmp)
    states = [(r["state"], r["prev"]) for r in rows if r["ev"] == "state"]
    count = lambda ev: len([r for r in rows if r["ev"] == ev])
    check("up after 3 replies, down after 3 losses, up again after 3 replies; 1-2 losses change nothing",
          states == [("up", None), ("down", "up"), ("up", "down")], states)
    check("down seconds run from the first lost probe to the first reply",
          [r.get("down_s") for r in rows if r["ev"] == "state"][-1] == 7.0)
    check("one loss row per lost probe", count("loss") == 6, count("loss"))
    check("late reply and ICMP error rows, DUP ignored", (count("late_reply"), count("icmp_error")) == (1, 1))


def run_files(incident_dir, n):
    names = ["ip-route", "ip6-route", "ip-neigh", "mtr-cf4", "mtr-g4", "mtr-cf6"]
    return [os.path.join(incident_dir, f"run{n:02d}-{name}.txt") for name in names]


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return ""


def file_done(path):
    return "# exit " in read_text(path)


async def selftest(keep):
    failed = []

    def check(label, cond, detail=""):
        print(f"{'PASS' if cond else 'FAIL'}  {label}" + (f"  [{detail}]" if detail else ""))
        if not cond:
            failed.append(label)

    for line, want in SAMPLES:
        check(f"parse {line[:58]!r}", parse_ping(line) == want)
    by_name = {t.name: t for t in make_targets()}
    for names, want in CLASSES:
        got = classify([by_name[n] for n in names])
        check(f"classify {'+'.join(names)} -> {want}", got == want, got)
    state_machine_check(check)

    tmp = tempfile.mkdtemp(prefix="wan-probe-selftest-")
    print(f"live part: fake target 192.0.2.1 in {tmp} (about 70 s)")
    fake = Target("fake", "192.0.2.1", 4, "internet")
    probe = Probe(tmp, [fake])
    events = os.path.join(tmp, "events.jsonl")
    probe.start()
    try:
        start = await wait_row(events, lambda r: r["ev"] == "incident_start", 20)
        check("incident opens once the fake target has lost 3 probes",
              start is not None and start["trigger"] == "fake")
        run2 = start and await wait_row(events, lambda r: r["ev"] == "incident_run" and r["run"] == 2, MTR_EVERY + 20)
        check("mtr set reruns while the incident lasts", bool(run2))
        if not run2:
            return failed
        flipped = time.time()
        fake.host = "127.0.0.1"
        fake.proc.terminate()
        up = await wait_row(events, lambda r: r["ev"] == "state" and r["state"] == "up", 20)
        check("fake target comes up after 3 replies (pointed at loopback)", up is not None)
        end = await wait_row(events, lambda r: r["ev"] == "incident_end", CLOSE_AFTER + 20)
        check("incident closes after the fake target has been up for 10 s", end is not None)
        if not (up and end):
            return failed
        check("classification of the incident", end["classification"] == "ipv4_only", end["classification"])
        check("per-target down seconds recorded", end["down_s"].get("fake", 0) > 30, end["down_s"])
        check("two mtr runs counted", end["runs"] == 2, end["runs"])
        check("close came 10 s after the target recovered",
              CLOSE_AFTER - 1 <= stamp(end) - stamp(up) <= CLOSE_AFTER + 2, round(stamp(end) - stamp(up), 1))

        incident_dir = start["dir"]
        for n in (1, 2):
            deadline = time.monotonic() + 40
            while time.monotonic() < deadline and not all(file_done(p) for p in run_files(incident_dir, n)):
                await asyncio.sleep(0.5)
            for path in run_files(incident_dir, n):
                text = read_text(path)
                body = [x for x in text.splitlines() if not x.startswith("#")]
                good = file_done(path) and "# exit 0" in text and bool(body)
                if os.path.basename(path).split("-", 1)[1].startswith("mtr"):
                    good = good and "HOST:" in text
                check(f"incident file {os.path.basename(path)}", good, f"{len(body)} lines")

        rows = read_rows(events)
        losses = [stamp(r) for r in rows if r["ev"] == "loss" and stamp(r) < flipped - 1]
        widest = max((b - a for a, b in zip(losses, losses[1:])), default=0.0)
        check("ping loop kept its 1 s cadence while mtr ran",
              len(losses) > 30 and widest < 2.5, f"{len(losses)} loss rows, max gap {widest:.2f} s")
        check("no error rows", not [r for r in rows if r["ev"] == "error"])

        counts = {}
        for r in rows:
            counts[r["ev"]] = counts.get(r["ev"], 0) + 1
        print(f"rows by event: {counts}")
        print("key rows:")
        for r in rows:
            if r["ev"] in ("incident_start", "incident_run", "state", "incident_end"):
                print("  " + json.dumps(r, separators=(",", ":")))
        print("incident directory:")
        for name in sorted(os.listdir(incident_dir)):
            print(f"  {name} {os.path.getsize(os.path.join(incident_dir, name))} bytes")
        print("run01-mtr-cf4.txt:")
        for line in read_text(os.path.join(incident_dir, "run01-mtr-cf4.txt")).splitlines():
            print("  " + line)
    finally:
        await probe.shutdown()
        if keep:
            print(f"kept {tmp}")
        else:
            shutil.rmtree(tmp)
            print(f"removed {tmp}")
    return failed


def stamp(row):
    return datetime.fromisoformat(row["ts"]).timestamp()


def main():
    ap = argparse.ArgumentParser(description="WAN outage forensics probe")
    ap.add_argument("--selftest", action="store_true",
                    help="run parser and classifier checks plus a live incident with a fake target, then exit")
    ap.add_argument("--keep", action="store_true", help="keep the selftest output directory")
    args = ap.parse_args()
    if args.selftest:
        failed = asyncio.run(selftest(args.keep))
        print("selftest FAILED: " + "; ".join(failed) if failed else "selftest passed")
        sys.exit(1 if failed else 0)
    asyncio.run(serve())


if __name__ == "__main__":
    main()
