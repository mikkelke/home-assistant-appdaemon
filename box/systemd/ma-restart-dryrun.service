[Unit]
Description=Dry run of ma-restart.service: consume the request, check MA's API and token, reload nothing
After=docker.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/unlink /data/appdaemon/host-requests/ma-restart-dryrun.request
ExecStart=/usr/local/sbin/ma-sonos-reload --dry-run
TimeoutStartSec=90
