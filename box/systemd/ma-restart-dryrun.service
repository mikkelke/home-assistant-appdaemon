[Unit]
Description=Dry run of ma-restart.service: consume the request, log MA's start time, restart nothing
After=docker.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/unlink /data/appdaemon/host-requests/ma-restart-dryrun.request
ExecStart=/usr/bin/docker inspect -f "musicassistant started {{.State.StartedAt}}" musicassistant
TimeoutStartSec=90
