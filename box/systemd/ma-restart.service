[Unit]
Description=Restart the Music Assistant container on an AppDaemon request
After=docker.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
# The AppDaemon container controls /data/appdaemon: root only unlinks the fixed request path
# there (unlink never follows it) and never reads, opens or writes anything under that tree.
# The restart runs only if the unlink succeeded, so a request that cannot be removed cannot loop.
ExecStart=/usr/bin/unlink /data/appdaemon/host-requests/ma-restart.request
ExecStart=/usr/bin/docker restart musicassistant
TimeoutStartSec=90
