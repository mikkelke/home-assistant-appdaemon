+
+
+def dropoff_at(latitude: float, longitude: float) -> dict:
+    """Build only the observed destination fields from Wolt tracking."""
+    return {
+        "delivery_location": {
+            "coordinates": {"type": "Point", "coordinates": [longitude, latitude]},
+        }
+    }
+
+
+@pytest.mark.parametrize(
+    ("latitude", "radius", "result"),
+    [
+        (55.0, 100, True),
+        (55.00025, 100, True),
+        (55.0007, 100, False),
+        (55.00025, 15, False),
+        (float("nan"), 100, None),
+        (10**400, 100, None),
+        (55.0, 0, None),
+    ],
+)
+def test_actual_dropoff_must_be_close_to_home(latitude, radius, result) -> None:
+    """Use the tighter of the home zone and the courier-specific limit."""
+    home = State("zone.home", "0", {"latitude": 55, "longitude": 12, "radius": radius})
+    assert delivers_to_home({}, dropoff_at(latitude, 12), home) is result
+
+
+def test_pickup_or_unknown_does_not_confirm_home() -> None:
+    """A pickup is outside scope even if the supplied point matches home."""
+    attributes = {"latitude": 55, "longitude": 12, "radius": 100}
+    home = State("zone.home", "0", attributes)
+    dropoff = dropoff_at(55, 12)
+    assert delivers_to_home({"delivery_method": "takeaway"}, dropoff, home) is False
+    assert delivers_to_home({}, {**dropoff, "delivery_method": "pickup"}, home) is False
+    assert delivers_to_home({}, {"latitude": 55, "longitude": 12}, home) is None
+    assert delivers_to_home({}, dropoff, None) is None
+    assert (
+        delivers_to_home({}, dropoff, State("zone.home", "unavailable", attributes))
+        is None
+    )
+
+
