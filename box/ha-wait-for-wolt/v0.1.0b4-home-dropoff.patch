+def delivers_to_home(
+    order: dict[str, Any], details: dict[str, Any], home: State | None
+) -> bool | None:
+    """Compare an explicit Wolt dropoff to Home Assistant's home location."""
+    for source in (order, details):
+        method = source.get("delivery_method")
+        if isinstance(method, str) and method.lower() in {"pickup", "takeaway"}:
+            return False
+
+    point = dropoff_coordinates(details)
+    if (
+        point is None
+        or home is None
+        or home.state in {STATE_UNAVAILABLE, STATE_UNKNOWN}
+    ):
+        return None
+
+    lat = home.attributes.get(ATTR_LATITUDE)
+    lon = home.attributes.get(ATTR_LONGITUDE)
+    radius = home.attributes.get("radius")
+    if not (
+        type(lat) in (float, int)
+        and -90 <= lat <= 90
+        and type(lon) in (float, int)
+        and -180 <= lon <= 180
+        and type(radius) in (float, int)
+        and 0 < radius < float("inf")
+    ):
+        return None
+    meters = distance(*point, lat, lon)
+    return None if meters is None else meters < min(radius, HOME_DROPOFF_MAX_DISTANCE_M)


